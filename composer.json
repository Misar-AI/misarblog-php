{
  "name": "misarai/misarblog-php",
  "description": "Official PHP SDK for the Misar.Blog developer API — articles, drafts, series, reactions, AI completion/titles, image generation, search, analytics, plan/trial. Full 23-operation coverage.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.misar.io/blog",
  "keywords": ["misarblog", "blog", "sdk", "php", "publishing", "content", "api"],
  "authors": [
    {
      "name": "Misar AI",
      "email": "hello@misar.io"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "MisarBlog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MisarBlog\\Tests\\": "tests/"
    }
  }
}
